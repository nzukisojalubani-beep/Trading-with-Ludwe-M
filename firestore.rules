rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('experienceLevel' in data) || data.experienceLevel in ['Beginner', 'Intermediate', 'Advanced']) &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    // Validation Blueprint for Bookmark
    function isValidBookmark(data) {
      return data.keys().hasAll(['id', 'userId', 'articleId', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.articleId is string && data.articleId.size() > 0 && data.articleId.size() <= 100 &&
             (!('articleTitle' in data) || (data.articleTitle is string && data.articleTitle.size() <= 200)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             data.createdAt is string && data.createdAt.size() <= 60;
    }

    // Validation Blueprint for JournalEntry
    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'pair', 'direction', 'entryPrice', 'stopLoss', 'takeProfit', 'outcome', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.pair is string && data.pair.size() > 0 && data.pair.size() <= 20 &&
             data.direction in ['BUY', 'SELL'] &&
             data.entryPrice is number && data.entryPrice >= 0 &&
             data.stopLoss is number && data.stopLoss >= 0 &&
             data.takeProfit is number && data.takeProfit >= 0 &&
             (!('lotSize' in data) || (data.lotSize is number && data.lotSize >= 0)) &&
             (!('riskPercent' in data) || (data.riskPercent is number && data.riskPercent >= 0 && data.riskPercent <= 100)) &&
             data.outcome in ['WIN', 'LOSS', 'BREAKEVEN', 'OPEN'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    // Validation Blueprint for UserProgress
    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'quizHighestScore', 'quizTotalAttempts', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.quizHighestScore is number && data.quizHighestScore >= 0 && data.quizHighestScore <= 100 &&
             data.quizTotalAttempts is number && data.quizTotalAttempts >= 0 &&
             (!('completedArticles' in data) || (data.completedArticles is list && data.completedArticles.size() <= 100)) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is string && data.lastActiveAt.size() <= 60)) &&
             data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    // Users Collection Root & Sub-collections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'photoURL', 'email', 'experienceLevel', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Bookmarks Subcollection
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(bookmarkId) &&
                         isValidBookmark(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(bookmarkId) &&
                         isValidBookmark(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }

      // Trading Journal Subcollection
      match /journal/{entryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasAny(['pair', 'direction', 'entryPrice', 'stopLoss', 'takeProfit', 'lotSize', 'riskPercent', 'outcome', 'notes', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }

      // Learning Progress Subcollection
      match /progress/{progressDoc} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(progressDoc);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressDoc) &&
                         isValidUserProgress(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressDoc) &&
                         isValidUserProgress(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasAny(['completedArticles', 'quizHighestScore', 'quizTotalAttempts', 'lastActiveAt', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressDoc);
      }
    }
  }
}
